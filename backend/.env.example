# Settings for the REST backend (accounts, loadouts, leaderboard, and it also serves the game page).
# Nothing here is needed to play on your own phone or PC: every line has a safe default.
# For a game on the internet, set these in your host's "Environment" screen.
# (Node 20.6 or newer can also read this file directly:  node --env-file=.env src/index.js)

# Port to listen on.
PORT=4000

# REQUIRED on the internet (the backend refuses to start without it when NODE_ENV=production).
# Use the SAME long random value on the backend and on the game server. Create one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SHARED_SECRET=

NODE_ENV=production

# Which websites may call the API: * (anyone) or a comma separated list, e.g.
#   https://border-ops.example.com,https://www.border-ops.example.com
CORS_ORIGIN=*

# Where accounts and the leaderboard are saved (db.json). On a host that wipes its disk on every
# deploy, point this at a persistent disk or the accounts will be lost.
DATA_DIR=./data

# Set to 1 when the app sits behind Render / Railway / Fly / nginx, so the rate limits see each
# player's real address instead of the proxy's.
TRUST_PROXY=1

# 0 = do not also serve ../frontend (use this when the page is hosted somewhere else).
SERVE_FRONTEND=1

# How many days a login stays valid.
TOKEN_TTL_DAYS=7
