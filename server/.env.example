# Settings for the multiplayer game server (Socket.IO). Every line has a safe default for local play.
# (Node 20.6 or newer can also read this file directly:  node --env-file=.env src/index.js)

# Port to listen on.
PORT=5000

# Where the REST backend lives. The game server reports finished matches there.
BACKEND_URL=http://localhost:4000

# REQUIRED on the internet. Must be EXACTLY the same value as on the backend.
SHARED_SECRET=

NODE_ENV=production

# Which websites may connect: * (anyone) or a comma separated list of origins.
CORS_ORIGIN=*

# Limits that protect a small server.
MAX_ROOMS=20
ROOM_CAPACITY=12
